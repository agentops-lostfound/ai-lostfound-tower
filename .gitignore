# 비밀값 (공유용 예시는 유지)
.env
.env.*
!.env.example

# Python 가상환경·독립 인터프리터·도구
.venv/
.venv-*/
venv/
.python/
.tools/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 다운로드 캐시·로그·실행 결과
.cache/
.huggingface/
logs/
*.log
# 실행 결과는 제외하되 Studio 배포 압축본·검증 해시·자세만 공유한다.
/outputs/*
!/outputs/robot_panel_live/
/outputs/robot_panel_live/*
!/outputs/robot_panel_live/poses.json
!/outputs/studio_pose_integration/
/outputs/studio_pose_integration/*
!/outputs/studio_pose_integration/bundle.tar.xz
!/outputs/studio_pose_integration/bundle.tar.xz.sha256
runs/

# 노드
node_modules/
dist/

