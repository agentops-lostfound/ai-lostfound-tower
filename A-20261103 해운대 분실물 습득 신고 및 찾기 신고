          <textarea id="description" name="description" maxlength="2000" placeholder="예: 검정색 직사각형 지갑이며 모서리에 작은 흠집이 있습니다."></textarea>
        </div>
      </div>
    </section>
    <hr style="border:0;border-top:1px solid #e5ece7;margin:22px 0">
    <section>
      <h2>2. 발견 장소</h2>
      <label for="found-place">해운대역 발견 장소 <span class="required">*</span></label>
      <select id="found-place" name="found_place" required>
        <option value="">장소 선택</option>
