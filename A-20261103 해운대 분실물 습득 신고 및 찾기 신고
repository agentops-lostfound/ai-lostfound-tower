<script>
(() => {
  const form = document.getElementById('found-form');
  const result = document.getElementById('result');
  let payload = null;
  const value = id => document.getElementById(id).value.trim();
  form.addEventListener('submit', event => {
    event.preventDefault();
    document.getElementById('form-error').textContent = '';
    if (!form.reportValidity()) return;
    payload = {
      item: {
        category: value('category'),
        name: value('item-name'),
        color: value('color') || null,
        material: value('material') || null,
        description: value('description') || null
      },
      location: {
        station: '해운대역',
        place: value('found-place'),
        detail: value('place-detail') || null
      },
      found_at: {
        date: value('found-date'),
        time: value('found-time'),
        timezone: 'Asia/Seoul'
      }
    };
    document.getElementById('summary').textContent =
      payload.item.name + ' · ' + payload.item.category + ' · ' +
      payload.location.place + ' · ' + payload.found_at.date + ' ' + payload.found_at.time;
    result.hidden = false;
    result.scrollIntoView({behavior:'smooth',block:'nearest'});
  });
  document.getElementById('download').addEventListener('click', () => {
    if (!payload) return;
    const blob = new Blob([JSON.stringify(payload, null, 2)], {type:'application/json'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'haeundae-found-item.json';
    a.click();
    URL.revokeObjectURL(url);
  });
})();
</script>
</body>
