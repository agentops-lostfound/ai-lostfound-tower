if(s===3)h+='<h2>분실물 특징</h2><p class="muted">물건의 특징을 항목별로 구분해 입력합니다.</p><div class="grid">'+select('종류 · category','category',['지갑','가방','휴대전화','전자기기','의류','액세서리','우산','열쇠','기타'])+select('색상 · color','color',['검정','흰색','회색','갈색','파랑','빨강','초록','노랑','기타'])+select('모양 · shape','shape',['직사각형','정사각형','원형','타원형','긴 형태','기타'])+select('재질 · material','material',['가죽','천·패브릭','금속','플라스틱','고무','나무','기타'])+field('표시·특징 · mark','mark','예: 모서리 스티커, 흠집')+field('보이는 글자 · visible_text','visible_text','예: 로고, 각인, 문구')+'</div>'+area('추가 자유 설명','description','그 밖의 특징을 작성해 주세요.')+'<div class="notice">자유 설명은 추후 LF-5 구조화 모듈에 연결해 category·color·shape·material·mark·visible_text로 변환할 수 있습니다. 현재 자동 구조화는 미연결입니다.</div>';
if(s===4)h+='<h2>분실물 후보 3개</h2><p class="muted">아래 후보 중 본인의 물건과 가장 비슷한 항목을 선택해 주세요.</p><div class="notice">신청자 화면에는 색상·모양·재질만 표시합니다. 내부 일치도 점수와 mark·visible_text(로고·스티커·각인 등)는 카드에서 공개하지 않습니다.</div>'+candidates.map((c,i)=>'<div class="candidate '+(state.chosen===i?'selected':'')+'"><button type="button" data-candidate="'+i+'"><b>'+c.id+'</b><span style="float:right" class="tag">'+(state.chosen===i?'선택됨':'후보')+'</span><div class="grid" style="margin-top:10px;font-size:13px"><div>색상<br><b>'+c.color+'</b></div><div>모양<br><b>'+c.shape+'</b></div><div>재질<br><b>'+c.material+'</b></div></div></button></div>').join('');
if(s===5)h+='<h2>확인 질문</h2><p class="muted">후보 카드에 공개하지 않은 세부 특징으로 소유 여부를 확인합니다.</p>'+select('확인 질문','question',['물건에 부착된 스티커의 색상이나 위치는 무엇인가요?','물건에 새겨진 글자 또는 각인 내용은 무엇인가요?','눈에 잘 띄지 않는 흠집이나 특징은 무엇인가요?'])+area('답변','answer','본인만 알 수 있는 내용을 작성해 주세요.')+'<div class="notice">실제 운영에서는 담당자만 확인할 수 있는 습득물 상세정보와 답변을 서버에서 대조해야 합니다. 현재 정답 검증은 미구현입니다.</div>';
if(s===6)h+='<h2>승인</h2><p class="muted">신청 내용을 확인하고 담당자 검토를 요청하는 단계입니다.</p><div class="summary"><b>신청 내용 요약</b><p>신청자: '+esc(state.data.name?state.data.name[0]+'***':'미입력')+'</p><p>분실물: '+esc(state.data.category||'미입력')+'</p><p>분실 장소: '+esc(state.data.lost_place||'미입력')+'</p><p>선택 후보: '+(state.chosen===null?'미선택':candidates[state.chosen].id)+'</p></div><div class="notice">이 화면의 확인은 데모 절차입니다. 실제 승인·본인 인증은 담당자 권한이 있는 백엔드에서 처리해야 합니다.</div><label><input type="checkbox" id="review" style="width:auto;margin-right:7px">신청 내용을 확인했습니다.</label>';
if(s===7)h+='<h2>수령 예약</h2><p class="muted">반환 승인 후 방문할 희망 일정을 입력합니다.</p>'+field('희망 수령 날짜','pickup_date','','date')+select('희망 수령 시간','pickup_time',['09:00~10:00','10:00~11:00','11:00~12:00','13:00~14:00','14:00~15:00','15:00~16:00','16:00~17:00'])+field('연락 가능한 전화번호','phone','전화번호 입력','tel')+'<div class="notice">실제 예약 확정 및 접수번호 발급은 예약 API·DB 연결 후 가능합니다.</div>';
$('content').innerHTML=h;
$('content').querySelectorAll('input:not([type=checkbox]):not([type=file]),textarea,select').forEach(el=>{el.addEventListener('input',()=>state.data[el.id]=el.value);el.addEventListener('change',()=>state.data[el.id]=el.value)});
$('content').querySelectorAll('[data-candidate]').forEach(b=>b.onclick=()=>{state.chosen=Number(b.dataset.candidate);draw()});
}
function validate(){let d=state.data,s=state.step;if(s===0&&!['c1','c2','c3','c4'].every(id=>$(id)?.checked))return '필수 동의 항목을 모두 확인해 주세요.';if(s===1&&(!d.name.trim()||!d.masked_id.trim()))return '이름과 마스킹된 신분증 번호를 입력해 주세요.';if(s===1&&!/[＊*•xX]/.test(d.masked_id))return '신분증 번호는 마스킹된 형태로만 입력해 주세요.';if(s===2&&(!d.category||!d.lost_date||!d.lost_place.trim()))return '분실물 종류, 날짜, 장소를 입력해 주세요.';if(s===3&&(!d.category||!d.color||!d.shape||!d.material))return '종류·색상·모양·재질을 입력해 주세요.';if(s===4&&state.chosen===null)return '후보를 선택해 주세요.';if(s===5&&(!d.question||!d.answer.trim()))return '확인 질문과 답변을 입력해 주세요.';if(s===6&&!$('review')?.checked)return '신청 내용을 확인해 주세요.';if(s===7&&(!d.pickup_date||!d.pickup_time||!d.phone.trim()))return '수령 날짜·시간·연락처를 입력해 주세요.';return ''}
$('prev').onclick=()=>{if(state.step>0){state.step--;draw();$('error').textContent=''}};
$('next').onclick=()=>{const e=validate();if(e){$('error').textContent=e;return}$('error').textContent='';state.done.add(state.step);if(state.step<7){state.step++;draw();return}
const maskedName=state.data.name.length<2?'*':state.data.name[0]+'*'.repeat(state.data.name.length-1);
const result={applicant:{name_masked:maskedName,id_number_masked:state.data.masked_id},lost_item:{category:state.data.category,color:state.data.color,shape:state.data.shape,material:state.data.material,mark:state.data.mark,visible_text:state.data.visible_text,description:state.data.description},candidate_id:candidates[state.chosen].id,verification:{question:state.data.question,answer:state.data.answer},pickup:{date:state.data.pickup_date,time:state.data.pickup_time,phone:state.data.phone}};
$('content').innerHTML='<span class="tag">DEMO COMPLETE</span><h2>신청 정보 입력 완료</h2><div class="summary"><b>입력 내용 확인 완료</b><p>선택 후보: '+result.candidate_id+'</p><p>신청자 이름(마스킹): '+maskedName+'</p><p>신분증 번호(마스킹): '+esc(result.applicant.id_number_masked)+'</p></div><div class="notice">이 화면은 실제 신청을 전송하거나 저장하지 않습니다. OCR·관리자 승인·예약·DB 저장·접수번호 발급은 서버 구현이 필요합니다. 신청자 이름은 마스킹해 기록 객체에 포함하며 원본 이름과 원본 신분증 번호는 기록 객체에 넣지 않습니다.</div><button class="btn secondary" id="export" type="button" style="margin-top:14px">데모 신청 데이터 JSON 다운로드</button>';
$('export').onclick=()=>{const blob=new Blob([JSON.stringify(result,null,2)],{type:'application/json'});const u=URL.createObjectURL(blob);const a=document.createElement('a');a.href=u;a.download='lost-found-claim-demo.json';a.click();URL.revokeObjectURL(u)};
$('next').classList.add('hidden');$('prev').classList.add('hidden');
};
draw();
})();
</script></body></html>
