48701eb21f3670", "questions_sha256": "2884e9ade1348723674e930e760228f3874a281188695b6a2b6e7b62e36e776e", "expected_questions": 6, "prompt_usage": [{"agent": "supervisor", "prompt": "chat-supervisor", "label": "staging", "version": null, "prompt_source": "code", "fallback_reason": "unavailable_or_disabled", "template_sha256": "9a5e6f7488cf9c5bc70dd6fcfc84f27ce72e9f13b3e42abf479b468e97ef3161", "model": "midm-2.0-mini", "temperature": 0, "use_llm": true, "setting_sources": {"model": "code", "temperature": "code", "use_llm": "env"}, "calls": 30}, {"agent": "planner", "prompt": "chat-planner", "label": "staging", "version": null, "prompt_source": "code", "fallback_reason": "unavailable_or_disabled", "template_sha256": "7dd063d696846a3b2dd1776ba480aa1182609158b857af494bb3db8b8a47c99e", "model": "midm-2.0-mini", "temperature": 0, "use_llm": true, "setting_sources": {"model": "code", "temperature": "code", "use_llm": "code"}, "calls": 3}, {"agent": "researcher", "prompt": "chat-researcher", "label": "staging", "version": null, "prompt_source": "code", "fallback_reason": "unavailable_or_disabled", "template_sha256": "544c1c733e92b81e8b7a42dc420fb2508ba1106761f17ac31552ed0972a6c22a", "model": "midm-2.0-mini", "temperature": 0, "use_llm": true, "setting_sources": {"model": "code", "temperature": "code", "use_llm": "code"}, "calls": 2}], "prompt_provenance": {"label": "staging", "attempts": 35, "code_fallback_calls": 35, "mixed_agents": [], "truncated": false, "staging_provenance_complete": false}}, "results": [{"no": 1001, "score": 1, "seconds": 2.0, "why": [], "turns": [{"say": "찾기 요청 취소하고 싶어요", "ok": true, "why": [], "seconds": 2.0, "status": "intake_question", "gen": "intake", "path": ["coordinator", "planner", "supervisor", "intake", "supervisor", "reporter", "supervisor"], "answer": "찾기 요청 취소를 도와드릴게요. 취소할 찾기 번호를 알려 주세요. 접수할 때 받은 번호예요(예: C-20261110-0001).", "choices": ["취소"]}], "group": "취소 시작", "model_calls": 3}, {"no": 1002, "score": 1, "seconds": 2.01, "why": [], "turns": [{"say": "예약 취소는 어떻게 해요?", "ok": true, "why": [], "seconds": 2.01, "status": "answered", "gen": "fixed_policy_text", "path": ["coordinator", "planner", "supervisor", "researcher", "supervisor", "reporter", "supervisor"], "answer": "찾기 요청과 방문 예약은 본센터에 오기 전까지 취소할 수 있어요. 분실인 웹에서 접수했다면 접수 완료 화면의 '찾기 요청 취소'를 눌러 주세요(신고할 때 넣은 가린 신분 번호로 본인 확인). 이 챗봇에 'C-… 취소'처럼 찾기 번호와 함께 말해도 본인 확인 뒤 취소돼요. 그 밖에는 본센터 직원에게 찾기 번호를 말씀해 주세요. 취소해도 물건은 계속 보관되고, 날짜를 바꾸려면 취소한 뒤 다시 신청하면 돼요. (프로젝트 시연 기준이며 실제 기관 안내가 아니에요.)", "choices": []}], "group": "취소 방법과 실행 구분", "model_calls": 4}, {"no": 1003, "score": 1, "seconds": 4.53, "why": [], "turns": [{"say": "본센터에서 물건은 직원한테 받나요?", "ok": true, "why": [], "seconds": 4.53, "status": "answered", "gen": "unavailable_or_invalid_excerpt_fallback", "path": ["coordinator", "planner", "supervisor", "researcher", "supervisor", "reporter", "supervisor"], "answer": "본센터 키오스크에서 ① 셀프 신분 확인을 하고 ② 물건 특징을 묻는 확인 질문에 답하면, ③ 로봇팔이 보관함에서 물건을 꺼내 제출보관함(물건 받는 칸)에 놓아요. ④ 제출보관함에서 물건을 직접 꺼낸 뒤 키오스크의 '물건 받았어요'를 누르면 끝나요(직원을 기다리지 않아요). 확인 질문이 맞지 않았거나 직원 보관 선반에 있는 물건이면 본센터 직원이 신분증과 물건을 확인한 뒤 건네 드려요.", "choices": []}], "group": "무인 수령 안내", "model_calls": 5}, {"no": 1004, "score": 1, "seconds": 4.83, "why": [], "turns": [{"say": "물건 받았어요 버튼은 언제 눌러요?", "ok": true, "why": [], "seconds": 4.83, "status": "answered", "gen": "generated", "path": ["coordinator", "planner", "supervisor", "researcher", "supervisor", "reporter", "supervisor"], "answer": "물건을 직접 꺼낸 뒤 키오스크의 '물건 받았어요' 버튼을 눌러요. 물건을 꺼낸 후 키오스크에서 '물건 받았어요' 버튼을 눌러요.", "choices": []}], "group": "수령 확인 버튼 안내", "model_calls": 5}, {"no": 1005, "score": 1, "seconds": 4.4, "why": [], "turns": [{"say": "분실 접수하기", "ok": true, "why": [], "seconds": 1.14, "status": "intake_question", "gen": "intake", "path": ["coordinator", "planner", "supervisor", "intake", "supervisor", "reporter", "supervisor"], "answer": "분실 접수를 도와드릴게요. 어떤 물건인가요? (휴대폰·보조배터리·핸드크림·립밤 중 하나)", "choices": ["휴대폰", "보조배터리", "핸드크림", "립밤", "취소"]}, {"say": "휴대폰", "ok": true, "why": [], "se