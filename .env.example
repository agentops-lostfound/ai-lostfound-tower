# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 절대 커밋하지 않는다.
# 팀 DB(docker compose, 포트 5434). 비밀번호는 아래 POSTGRES_PASSWORD 와 같게
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://lostfound:비밀번호@127.0.0.1:5434/lostfound
# 관제탑 API: 1 이면 DB 부품·반환 기록을 PostgreSQL 로(기본 0 = 가짜 부품·메모리)
TOWER_DB=0
TOWER_SEND=0
# 탑뷰 결과 파일(김건태 LF-3 result_with_qwen.json) 또는 그 폴더. 비우면 가짜 탑뷰 부품
TOWER_VISION_FILE=
# 탑뷰 결과를 몇 초까지 믿을지(0 = 검사 안 함, 저장해 둔 파일로 시험할 때)
TOWER_VISION_MAX_AGE=600
# 매칭 부품: 비우면 김건태 matching/policy.py(11/3 기본), simple 이면 예전 단순 비교
TOWER_MATCHER=
TOWER_REVIEWER=0
DISCORD_WEBHOOK_URL=
# 관제 채널별 웹후크(비우면 DISCORD_WEBHOOK_URL 하나로 보냄)
DISCORD_WEBHOOK_PROGRESS=
DISCORD_WEBHOOK_ALERT=
DISCORD_WEBHOOK_SCORE=
# 팀 대화 채널(부산7기 #2조-분실물관리시스템) — 반환 1건당 결과 한 줄. 비우면 보내지 않음
DISCORD_WEBHOOK_TEAM=
DISCORD_BOT_TOKEN=
OPENROUTER_API_KEY=

# Hugging Face Hub (데이터셋·모델 공유, 비공개 저장소)
HF_TOKEN=
HF_DATA_REPO=agentops-lostfound/lf-vision-data
HF_MODEL_REPO=agentops-lostfound/lf-vision-models

# 메인 AI LLM 검토(Ollama 로컬). 비전과 같은 Qwen3-VL-4B를 함께 써서 GPU 메모리를 아낀다
OLLAMA_URL=http://localhost:11434
MAIN_AI_MODEL=qwen3-vl:4b-instruct
# 0 이면 답한 뒤 바로 메모리에서 내림(SmolVLA 집기 전에 비우고 싶을 때)
OLLAMA_KEEP_ALIVE=5m
# LLM 검토 시간 한도(초). 넘으면 보류(직원 확인)
REVIEWER_TIMEOUT=60
# 생각(thinking) 모드. qwen3-vl:4b(생각 전용판)는 답마다 약 10초 → instruct판 + false 를 쓴다
REVIEWER_THINK=false
