# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 절대 커밋하지 않는다.
DATABASE_URL=postgresql://user:password@localhost:5432/lostfound
DISCORD_WEBHOOK_URL=
# 관제 채널별 웹후크(비우면 DISCORD_WEBHOOK_URL 하나로 보냄)
DISCORD_WEBHOOK_PROGRESS=
DISCORD_WEBHOOK_ALERT=
DISCORD_WEBHOOK_SCORE=
DISCORD_BOT_TOKEN=
OPENROUTER_API_KEY=

# Hugging Face Hub (데이터셋·모델 공유, 비공개 저장소)
HF_TOKEN=
HF_DATA_REPO=agentops-lostfound/lf-vision-data
HF_MODEL_REPO=agentops-lostfound/lf-vision-models

# 메인 AI LLM 검토(Ollama 로컬). 비전과 같은 Qwen3-VL-4B를 함께 써서 GPU 메모리를 아낀다
OLLAMA_URL=http://localhost:11434
MAIN_AI_MODEL=qwen3-vl:4b
# 0 이면 답한 뒤 바로 메모리에서 내림(SmolVLA 집기 전에 비우고 싶을 때)
OLLAMA_KEEP_ALIVE=5m
