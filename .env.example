# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 절대 커밋하지 않는다.
# 팀 DB(docker compose, 포트 5434). 비밀번호는 아래 POSTGRES_PASSWORD 와 같게
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://lostfound:비밀번호@127.0.0.1:5434/lostfound
# 관제탑 API: 1 이면 DB 부품·반환 기록을 PostgreSQL 로(기본 0 = 가짜 부품·메모리)
TOWER_DB=0
TOWER_SEND=0
# 탑뷰 결과 파일(김건태 LF-3 result_with_qwen.json) 또는 그 폴더. 비우면 가짜 탑뷰 부품
TOWER_VISION_FILE=
# 탑뷰 결과를 몇 초까지 믿을지(0 = 검사 안 함, 저장해 둔 파일로 시험할 때)
TOWER_VISION_MAX_AGE=600
# 매칭 부품: 비우면 김건태 matching/policy.py(11/3 기본), simple 이면 예전 단순 비교
TOWER_MATCHER=
# LLM 검토: 시연 PC 는 1 + 아래 MAIN_AI_DEVICE=cpu (11/4 결정, 값 뒤에 설명을 붙이지 않는다 — .env 읽기가 줄 끝 주석을 지원하지 않음)
TOWER_REVIEWER=0
# LLM 검토를 CPU 로(GPU 안 씀, 시연 PC 에서 STT·Qwen·VLA 와 겹치지 않게). gpu(기본) | cpu
MAIN_AI_DEVICE=
# 관제탑 메인 AI(11/8, agents/tower_brain.py): 매칭이 애매하면 매칭·보관 칸·비전 에이전트와 근거를 모은 뒤 결론(로봇 진행 기준은 그대로) — 안내 docs/design/tower_main_ai.md
# 1 이면 켬. 가상 시연에서 보려면 분실 메시지 끝에 #흐린촬영
TOWER_BRAIN=0
# 메인 AI 가 다음 에이전트를 고를 때 쓰는 모델(비우면 LF_CHAT_RAG_MODEL, 그것도 비면 정해진 순서)
TOWER_BRAIN_MODEL=
DISCORD_WEBHOOK_URL=
# 관제 채널별 웹후크(비우면 DISCORD_WEBHOOK_URL 하나로 보냄)
DISCORD_WEBHOOK_PROGRESS=
DISCORD_WEBHOOK_ALERT=
DISCORD_WEBHOOK_SCORE=
# 팀 대화 채널(부산7기 #2조-분실물관리시스템) — 반환 1건당 결과 한 줄. 비우면 보내지 않음
DISCORD_WEBHOOK_TEAM=
# 11/9 에이전트 대화 채널(#🤖에이전트-대화) — 에이전트끼리 요청·답·채점·도움을 대화 하나씩 묶어 보냄. 비우면 /live 에서만 보임
DISCORD_WEBHOOK_AGENT=
# 에이전트 대화 켜기(가상 시연 TOWER_SIM=1 은 기본 켜짐, 0 이면 끔, 실제 관제탑은 1 일 때만)
TOWER_AGENT_TALK=
DISCORD_BOT_TOKEN=
OPENROUTER_API_KEY=

# Hugging Face Hub (데이터셋·모델 공유, 비공개 저장소)
HF_TOKEN=
HF_DATA_REPO=agentops-lostfound/lf-vision-data
HF_MODEL_REPO=agentops-lostfound/lf-vision-models

# 메인 AI LLM 검토(Ollama 로컬). 비전과 같은 Qwen3-VL-4B를 함께 써서 GPU 메모리를 아낀다
OLLAMA_URL=http://localhost:11434
MAIN_AI_MODEL=qwen3-vl:4b-instruct
# 0 이면 답한 뒤 바로 메모리에서 내림(SmolVLA 집기 전에 비우고 싶을 때)
OLLAMA_KEEP_ALIVE=5m
# LLM 검토 시간 한도(초). 넘으면 보류(직원 확인)
REVIEWER_TIMEOUT=60
# 생각(thinking) 모드. qwen3-vl:4b(생각 전용판)는 답마다 약 10초 → instruct판 + false 를 쓴다
REVIEWER_THINK=false
# GPU 사용권(agents/gpu_lease.py, 11/4): 관제탑이 로봇(VLA) 전에 STT·Qwen 이 GPU 를 비웠는지 확인. 비움 = 켬, 0 = 끔
TOWER_GPU_LEASE=
# 사용권을 기다리는 최대 초(기본 60). 넘으면 로봇을 움직이지 않고 직원 확인
TOWER_GPU_WAIT=
# 사용권을 받은 뒤 GPU 남은 메모리가 이 MB 이상일 때만 진행(비움 = 확인 안 함, 값은 VLA 실측 뒤 TBD)
TOWER_GPU_FREE_MB=
# 잠금 파일 위치(비움 = 임시 폴더 agentops_gpu.lock). STT·Qwen·VLA·관제탑이 모두 같은 값이어야 함
GPU_LEASE_FILE=
# ---------- 전체 가상 시연(11/4, docs/design/virtual_demo.md) ----------
# 1 = 등록기계·Qwen·탑뷰·로봇팔을 가상 부품으로(접수·DB 는 메모리, TOWER_DB 무시). 비움 = 끔
TOWER_SIM=
# 11/10 가상 시연 기록을 팀 DB(위 DATABASE_URL)에도 함께 저장 — 키오스크 접수·상태·찾기 요청·반환 기록이 본센터 DB 에 남는다(agents/db_mirror.py)
# tools\start_tower.bat 가 1 로 켠다(끄기: start_tower.bat nodb). 직접 uvicorn 으로 켤 때만 여기서 정한다. 비움·0 = 메모리만
TOWER_SIM_DB=
# 11/9 로봇이 물건 위치를 얻는 곳: db = 보관함 칸 저장 자세(pose_1~8, 탑뷰 없이) · 비움 = 탑뷰 매칭 좌표(예전 그대로)
#   안내 docs/contracts/robot_db_target.md — db 는 로봇 부품에 robot_go_pose 가 있어야 움직임(없으면 직원 확인)
TOWER_ROBOT_TARGET=
# 11/9 진짜 로봇팔 부품(모듈:클래스, 예 robot.tower_part:TowerRobot). 비움 = 가짜 로봇 — agents/robot_part.py
TOWER_ROBOT_PART=
# LF-21 회수 버튼 → 원격 티칭 11단계. 비움 = 기존 흐름. taught는 DB 모드·원격 부품과 함께 명시.
TOWER_ROBOT_SEQUENCE=
# LF-21 Studio IPC 부품 설정(값을 비우면 연결 불가, 생성·import만으로 장비에 연결하지 않음)
TOWER_STUDIO_FOLLOWER_ID=
# 비움 대신 기본값을 사용하려면 해당 줄을 생략: physical-ai-studio-cuda / Ubuntu-24.04
TOWER_STUDIO_CONTAINER=physical-ai-studio-cuda
TOWER_STUDIO_DISTRIBUTION=Ubuntu-24.04
# 저장 자세 JSON 경로(비움 = 저장소 outputs/robot_panel_live/poses.json), 이동 시간 = 3/4/5
TOWER_ROBOT_POSES=
TOWER_ROBOT_MOVE_SECONDS=3
# LF-21 두 PC 원격 실행: 관제탑은 robot.remote_client:RemoteTowerRobot 사용
# URL은 로봇 PC의 실행 서버, 키는 두 PC에 비공개로 동일하게 설정(32자 이상)
TOWER_REMOTE_ROBOT_URL=
TOWER_REMOTE_ROBOT_TOKEN=
# 실물은 live. 모의 통신 시험에서만 simulation을 명시한다.
TOWER_REMOTE_ROBOT_MODE=live
# 11/9 키오스크 서버 카메라: 태블릿은 화면만, 웹캠은 관제탑 PC(키오스크 기계=OpenCV 카메라 번호, tools/list_cameras.py 로 확인). 비우면 끔
TOWER_KIOSK_CAMERAS=
# 가상 시간 배수(기본 1 = 반환 한 번 약 20초, 0.5 = 두 배 빠르게)
TOWER_SIM_SPEED=
# 가상 시연의 처음 물건: 비우면 분홍 핸드크림 하나(R3-1, 11/10). full = 예전 5개 묶음(휴대폰 2·보조배터리 2·카드지갑 1 — 칸 대기·닮은 물건 장면 연습용)
TOWER_SIM_SEED=
# 1 = 바구니 전달 뒤 자동 인계하지 않고 직원 화면(/staff) 버튼을 기다림
TOWER_SIM_MANUAL_HANDOVER=
# 11/7 가상 시연: 키오스크 사진 접수 후 Qwen 작업자(tools/intake_qwen_worker.py) 결과를 기다리는 최대 초(비움 = 180)
TOWER_SIM_QWEN_WAIT=
# 전용 분실물 봇(tools/lostfound_bot.py) 토큰 — 디스코드 개발자 포털에서 직접 만들어 넣는다
LOSTFOUND_BOT_TOKEN=
# 봇이 읽을 분실물 채널 번호(여러 개면 쉼표)
LOSTFOUND_CHANNEL_ID=
# 봇이 부를 관제탑 주소(비움 = http://127.0.0.1:8100)
TOWER_URL=
# 진행판 끝에 붙일 실시간 화면 주소(선택)
LIVE_URL=

# AI 챗봇 위젯(LF-5, agents/chat_api.py) — 화면에 <script src="/chat-widget/widget.js"> 한 줄
# 문서 답변을 다듬을 로컬 Ollama 모델 이름(비우면 문서 문단 그대로 안내)
# 11/7 결정: midm-2.0-mini(KT Mi:dm 2.0 Mini, MIT) — 등록 docs/ollama/README.md, 근거 docs/design/chatbot_sllm_rag.md §9
# (Qwen3-4B-2507 이 가장 정확했지만 RTX 3050 6GB 를 Qwen3-VL 과 함께 써야 해서 메모리가 적은 Mi:dm 선택)
# 비우면 모델 없이 문서 문장 + 규칙 되묻기
LF_CHAT_RAG_MODEL=
# 실제 팀 DB 물건 검색(본인인증 세션 검증기 연결 전에는 열리지 않음). 비우면 가상 물건 DB
LF_CHAT_DATABASE_URL=
# 가상 물건 DB 파일(기본 .cache/chat-demo.sqlite3), 0 이면 물건 검색 끔
TOWER_CHAT_DEMO_DB=
# 관제 분석·보고 에이전트(tools/ops_report.py, 관리자 화면 챗봇의 관제 질문) 보고서 문장을 다듬을 로컬 Ollama 모델
# 비우면 tools/ops_report.py 는 템플릿 보고서, 관리자 화면 챗봇은 LF_CHAT_RAG_MODEL 을 씀
OPS_ANALYST_MODEL=
# 챗봇 coordinator·planner(DeerFlow 구조, agents/chat_agents.py)를 모델로 판단할지. 0 이면 규칙만(모델은 답 작성에만)
LF_CHAT_AGENT_ROUTING=
# coordinator·planner 에 쓸 모델(비우면 LF_CHAT_RAG_MODEL 과 같은 모델 — 다른 모델이면 그래픽카드 메모리가 더 듦)
LF_CHAT_AGENT_MODEL=
# 11/9 칸(agent)별 모델 설정 — Langfuse 프롬프트 config 가 먼저, 없으면 이 값, 없으면 코드 기본값(docs/design/chatbot_agents.md 1-1장)
# 이름: LF_AGENT_<칸>_MODEL · _TEMPERATURE · _USE_LLM (칸 예: PLANNER · SUPERVISOR · OPS_ANALYST). 예) LF_AGENT_SUPERVISOR_USE_LLM=1

# Langfuse 실행 기록·프롬프트 관리(LF-5, agents/observability.py · agents/prompts.py) — 안내 docs/design/chatbot_sllm_rag.md §11
# 키는 Langfuse 화면 Settings → API Keys 에서 만든 값. 셋 중 하나라도 비면 기록을 보내지 않고 챗봇은 그대로 동작
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 미국 서버로 가입했으면 https://us.cloud.langfuse.com (유럽은 https://cloud.langfuse.com)
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# 기록에 붙는 환경 이름(dev·demo 등, 비우면 dev)
LANGFUSE_ENV=
# 0 이면 키가 있어도 기록 끔 / LF_LANGFUSE_CALLBACK=0 이면 그래프 칸 콜백 기록만 끄고 직접 기록으로
LF_LANGFUSE=
LF_LANGFUSE_CALLBACK=
# 11/9 Langfuse 로 보내는 간격(초, 기본 1). 질문이 끝나면 따로 바로 보냄 — /chat/health 의 langfuse 로 켜짐·이유 확인
LANGFUSE_FLUSH_INTERVAL=

# Docker 포트를 어디에 열지(docker-compose.yml, 바꾸면 docker compose up -d) — 안내 web/README.md 5-1
# 팀 DB 5434: 비움 = 이 PC 안에서만(127.0.0.1), 0.0.0.0 = 교육원 네트워크 팀원 PC 에서도(비밀번호 바꾼 뒤에만)
DB_BIND=
# 화면 앞문 8080: 비움 = 모든 주소(기본), 127.0.0.1 = 이 PC 안에서만
WEB_BIND=

# 관리자 로그인 (LF-2): 비밀번호를 정하면 관리자 API(/api/admin/*)가 로그인 필요. 비우면 로그인 꺼짐(시연용). 값은 관제탑 PC .env 에만
LF_ADMIN_PASSWORD=
# 세션 서명 비밀(선택, 비우면 관제탑을 켤 때마다 새로 만듦) · 봇·스크립트용 키(선택, 헤더 X-Admin-Key)
LF_ADMIN_SECRET=
LF_ADMIN_API_KEY=
