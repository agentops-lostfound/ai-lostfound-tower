# 화면 앞문(nginx, 8080) — 모든 요청을 관제탑(8100)으로 넘긴다 (11/5 단일화)
# 화면 파일은 관제탑이 web/ 폴더에서 바로 읽어 준다 → 화면을 고치면 새로 고침만 하면 된다(이미지 다시 만들 필요 없음)
# ${TOWER_URL} 은 컨테이너가 켜질 때 nginx 공식 이미지가 환경값으로 채운다
server {
  listen 80;
  server_name _;
  client_max_body_size 8m;   # 사진 data URL(최대 5MB) 여유
  # 11/5: 주소 넘기기(302)를 "/kiosk" 처럼 상대 주소로 보낸다. 기본(absolute_redirect on)은 컨테이너 안 포트(80)로 바꿔
  #       http://127.0.0.1:8080/ → http://127.0.0.1/kiosk 로 튕겨 열리지 않았다(다른 PC 도 같음)
  absolute_redirect off;

  location = / {
    return 302 /kiosk$is_args$args;   # 첫 화면 = 키오스크
  }

  location / {
    proxy_pass ${TOWER_URL};
    proxy_set_header Host $http_host;   # 포트(:8080)까지 넘겨 관제탑이 만드는 주소도 포트를 잃지 않게(11/5)
    proxy_set_header X-Real-IP $remote_addr;
    proxy_connect_timeout 5s;
  }
}
